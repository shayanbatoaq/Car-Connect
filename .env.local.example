# Paste your Supabase project URL here.
NEXT_PUBLIC_SUPABASE_URL=

# Paste your Supabase anon public key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paste your Supabase service role key here.
# Server-side only. Never expose this value in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for QR sticker URLs, for example:
# https://safesafar.pk
NEXT_PUBLIC_SITE_URL=

# Simple MVP admin password for /admin.
# TODO: Replace this with real admin authentication before production.
ADMIN_PASSWORD=
